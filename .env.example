# ==============================================================================
# CA Buddy - cPanel & Node.js Environment Configuration
# ==============================================================================

# Server Port (cPanel will assign automatically or use 5001)
PORT=5001

# MySQL Database Configuration (from cPanel MySQL Database Wizard)
DB_HOST=localhost
DB_USER=your_cpanel_db_user
DB_PASSWORD=your_cpanel_db_password
DB_NAME=your_cpanel_db_name
DB_PORT=3306

# Frontend API Base URL (leave empty for same-origin proxy or specify your domain)
# VITE_API_BASE=https://yourdomain.com/api
